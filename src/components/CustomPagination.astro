---
// src/components/CustomPagination.astro
import Default from '@astrojs/starlight/components/Pagination.astro';
import Comments from './Comments.astro';

const starlightRoute = Astro.locals?.starlightRoute;
const template = starlightRoute?.entry?.data?.template ?? Astro.props?.entry?.data?.template;

const pathname = Astro.url.pathname;
const isHomePath = pathname === '/' || pathname === '/en/' || pathname === '/ja/';

const isSplash = template === 'splash' || isHomePath;
---

<Default {...Astro.props}>
  <slot />
</Default>

{!isSplash && <Comments />}
