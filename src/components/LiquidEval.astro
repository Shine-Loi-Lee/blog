---
import fs from 'fs';
import path from 'path';

const starlightRoute = Astro.locals?.starlightRoute;
const rawDocId = starlightRoute?.id ?? '';
const docId = rawDocId.replace(/^(en|ja)\//, '');
const currentLang = (starlightRoute?.lang ?? 'ko') as 'ko' | 'en' | 'ja';

const i18n = {
  ko: {
    title: 'LIQUID 철학 평가',
    total: '종합 점수',
    commentHeader: 'AI 비평 총평',
    axes: {
      linkedKnowledge: 'L: 연계 지식',
      intuitiveInterface: 'I: 직관적 흐름',
      qualitativeLearning: 'Q: 질적 배움',
      understandableExplanation: 'U: 명료한 설명',
      interactiveExperience: 'I: 상호작용성',
      deepDive: 'D: 심층 탐구',
    },
  },
  en: {
    title: 'LIQUID Philosophy Evaluation',
    total: 'Total Score',
    commentHeader: 'AI Critical Synthesis',
    axes: {
      linkedKnowledge: 'L: Linked Knowledge',
      intuitiveInterface: 'I: Intuitive Flow',
      qualitativeLearning: 'Q: Qualitative Learning',
      understandableExplanation: 'U: Understandable',
      interactiveExperience: 'I: Interactive',
      deepDive: 'D: Deep Dive',
    },
  },
  ja: {
    title: 'LIQUID 哲学評価',
    total: '総合スコア',
    commentHeader: 'AI 批評総評',
    axes: {
      linkedKnowledge: 'L: 連結知識',
      intuitiveInterface: 'I: 直感的構造',
      qualitativeLearning: 'Q: 質的学習',
      understandableExplanation: 'U: 明瞭な説明',
      interactiveExperience: 'I: 相互作用',
      deepDive: 'D: 深層探求',
    },
  },
};

const t = i18n[currentLang] ?? i18n.ko;

let evalData = null;
const dataPath = path.resolve(process.cwd(), 'src/data/liquid-evals.json');
if (fs.existsSync(dataPath)) {
  const allData = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  evalData = allData[docId] ?? allData[rawDocId];
}

function getPoints(scores: any) {
  const values = [
    scores.linkedKnowledge,
    scores.intuitiveInterface,
    scores.qualitativeLearning,
    scores.understandableExplanation,
    scores.interactiveExperience,
    scores.deepDive,
  ];

  const centerX = 150;
  const centerY = 150;
  const radius = 100;

  return values
    .map((val, i) => {
      const angle = (Math.PI / 3) * i - Math.PI / 2;
      const r = (val / 10) * radius;
      const x = centerX + r * Math.cos(angle);
      const y = centerY + r * Math.sin(angle);
      return `${x},${y}`;
    })
    .join(' ');
}
---

{evalData && (
  <details class="liquid-details">
    <summary class="liquid-summary">
      <span class="title">{t.title}</span>
      <span class="score">{t.total}: {evalData.totalScore.toFixed(1)} / 10</span>
    </summary>

    <div class="liquid-content">
      <div class="chart-container">
        <svg viewBox="0 0 300 300" class="radar-chart" aria-label="LIQUID Radar Chart">
          <polygon
            points={getPoints({ linkedKnowledge: 10, intuitiveInterface: 10, qualitativeLearning: 10, understandableExplanation: 10, interactiveExperience: 10, deepDive: 10 })}
            class="bg-polygon"
          />
          <polygon
            points={getPoints({ linkedKnowledge: 5, intuitiveInterface: 5, qualitativeLearning: 5, understandableExplanation: 5, interactiveExperience: 5, deepDive: 5 })}
            class="bg-polygon mid"
          />

          <text x="150" y="34" text-anchor="middle">{t.axes.linkedKnowledge} ({evalData.scores.linkedKnowledge})</text>
          <text x="260" y="90" text-anchor="middle">{t.axes.intuitiveInterface} ({evalData.scores.intuitiveInterface})</text>
          <text x="260" y="224" text-anchor="middle">{t.axes.qualitativeLearning} ({evalData.scores.qualitativeLearning})</text>
          <text x="150" y="280" text-anchor="middle">{t.axes.understandableExplanation} ({evalData.scores.understandableExplanation})</text>
          <text x="40" y="224" text-anchor="middle">{t.axes.interactiveExperience} ({evalData.scores.interactiveExperience})</text>
          <text x="40" y="90" text-anchor="middle">{t.axes.deepDive} ({evalData.scores.deepDive})</text>

          <polygon points={getPoints(evalData.scores)} class="score-polygon" />
        </svg>
      </div>

      <div class="comment-box">
        <h4>{t.commentHeader}</h4>
        <p>{evalData.comment}</p>
      </div>
    </div>
  </details>
)}

<style>
  .liquid-details {
    margin: 2rem 0;
    border: 1px solid var(--sl-color-blue-low);
    background-color: var(--sl-color-blue-low);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .liquid-summary {
    padding: 1rem 1.5rem;
    cursor: pointer;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--sl-color-gray-6);
    user-select: none;
  }

  .liquid-summary:hover {
    background-color: var(--sl-color-gray-5);
  }

  .score {
    color: var(--sl-color-text-accent);
    font-size: 1.05rem;
  }

  .liquid-content {
    padding: 2rem;
    display: flex;
    gap: 2rem;
    align-items: center;
    flex-wrap: wrap;
    background-color: var(--sl-color-bg);
  }

  .chart-container {
    flex: 1;
    min-width: 260px;
    max-width: 350px;
    margin: 0 auto;
  }

  .radar-chart text {
    fill: var(--sl-color-text);
    font-size: 11px;
    font-weight: 500;
  }

  .bg-polygon {
    fill: none;
    stroke: var(--sl-color-gray-5);
    stroke-width: 1;
  }

  .bg-polygon.mid {
    stroke-dasharray: 3 3;
    stroke: var(--sl-color-gray-4);
  }

  .score-polygon {
    fill: rgba(65, 105, 225, 0.25);
    stroke: var(--sl-color-text-accent);
    stroke-width: 2;
  }

  .comment-box {
    flex: 1;
    min-width: 260px;
  }

  .comment-box h4 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    color: var(--sl-color-white);
    font-size: 1.05rem;
  }

  .comment-box p {
    color: var(--sl-color-gray-2);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }
</style>